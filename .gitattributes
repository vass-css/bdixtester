# .gitattributes — normalize text line endings and mark Android binary assets
* text=auto eol=lf

# Android & Gradle scripts
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.pro text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Python & Scripts
*.py text eol=lf

# Docs & Config
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.p12 binary
